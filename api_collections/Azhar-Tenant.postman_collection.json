  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/Account/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{tenantLogin}}\",\n  \"password\": \"{{tenantPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login successful', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "const j = pm.response.json(); if (j.accessToken) pm.collectionVariables.set('accessToken', j.accessToken); if (j.refreshToken) pm.collectionVariables.set('refreshToken', j.refreshToken); if (j.user && j.user.id) pm.collectionVariables.set('userId', j.user.id); if (j.user && j.user.tenantId) pm.collectionVariables.set('tenantId', j.user.tenantId); if (j.user && j.user.staffId) pm.collectionVariables.set('staffId', j.user.staffId);",
                  "pm.test('Role is Tenant', function () { pm.expect(pm.response.json().user.role).to.eql('Tenant'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Current Session",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/Account/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is below 500', function () { pm.expect(pm.response.code).to.be.below(500); });"
                ]
              }
            }
          ]
        },
