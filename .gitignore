node_modules/
build/
dist/
coverage/
.DS_Store
*.log
server.log

# Secrets: never commit real credentials. .env.example is a template only.
.env*
!.env.example

# local data / backups
*.sqlite
*.db

# Backup archive: dumps are binary artefacts that would bloat the repository.
# Keep the folder and its explanation, ignore the files themselves.
backups/*
!backups/.gitkeep
!backups/README.md
