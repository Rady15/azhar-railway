NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Never auto-seed demo data. Empty database must stay empty.
# (Seeding is opt-in: only when SEED_DEMO_DATA=true)
SKIP_SEED=true
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=m.barmada
ADMIN_EMAIL=admin@azhar.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
CORS_ORIGIN=http://localhost:3000
VITE_API_BASE=/api

# Firebase Web Push (set these in the build environment for Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=

# Backups
BACKUP_DIR=./backups

# Password recovery delivery (optional but recommended in production)
# The server POSTs {email,name,resetToken,expiresMinutes} to this HTTPS endpoint.
PASSWORD_RESET_CALLBACK_URL=
PASSWORD_RESET_CALLBACK_SECRET=
# Staging/dev only. NEVER enable in production.
PASSWORD_RESET_EXPOSE_TOKEN=false

# WhatsApp notifications (Maintenance / Complaints).
# Leave empty to run with WhatsApp disabled (requests still save + in-app
# notifications still work; WhatsApp is skipped and logged as failed).
# Provider: meta_cloud | twilio | custom
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=https://graph.facebook.com/v17.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_PHONE=
WHATSAPP_TEMPLATE_NAME=maintenance_request
WHATSAPP_TEMPLATE_LANGUAGE=en_US
